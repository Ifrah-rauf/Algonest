
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Auth {
  auth_id   Int        @default(autoincrement())
  uid      String      @id @default(uuid()) 
  mail      String     @unique
  password  String?
  username  String?
  createdAt DateTime   @default(now())

  student   StAccount?
  teacher   TAccount?
}
model StAccount {
  s_id       Int           @id @default(autoincrement())
  uid        String        @unique 
  name       String      
  is_demo    Boolean       @default(false)
  updated_at DateTime?     

  auth       Auth          @relation(fields: [uid], references: [uid])
  plans      PlanRecord[]
  classes    ClassRecord[]
}
model Specialization {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  teachers  TAccount[]  @relation("TeacherSpecs")
}
model TAccount {
  t_id       Int           @id @default(autoincrement())
  uid        String        @unique
  name       String      
  bio        String?
  rating     Float?
  updated_at DateTime?     

  auth       Auth          @relation(fields: [uid], references: [uid])
  specs      Specialization[] @relation("TeacherSpecs")
  classes    ClassRecord[]
}
model PlanDesc {
  plan_id           Int           @id
  plan_name         String
  desc              String?
  duration          String
  price             Float
  sessionsIncluded  Int

  records           PlanRecord[]  //records field will contain array from PlanRecord table foreign key:plan_id, all enrollments of this plan
}
enum ConsultStatus {
  TAKEN
  DEMANDED
  NOT_TAKEN
}
model PlanRecord {  //plan enrollment table
  record_no   Int        @id @default(autoincrement())
  s_id        Int
  plan_id     Int 
  joinAt      DateTime   @default(now())
  sessionsRem Int
  isValid     Boolean    @default(true)
  payCheck    Boolean    @default(false)
  consultStat ConsultStatus @default(NOT_TAKEN)

  student     StAccount  @relation(fields: [s_id], references: [s_id])
  plan        PlanDesc   @relation(fields: [plan_id], references: [plan_id]) //type of plan taken
  classes     ClassRecord[] //classes field will contain array from ClassRecord table foreign key:  
}
model ClassRecord {
  record_no Int      @id @default(autoincrement())
  t_id      Int
  s_id      Int
  plan_record_id   Int //class covered by which plan
  link      String?
  startAt   DateTime
  endAt     DateTime?

  teacher   TAccount @relation(fields: [t_id], references: [t_id])
  student   StAccount @relation(fields: [s_id], references: [s_id])
  planRecord    PlanRecord  @relation(fields: [plan_record_id], references: [record_no])  //type of plan taken
}